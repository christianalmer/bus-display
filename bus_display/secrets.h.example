// Copy to secrets.h (gitignored) and fill in real values.
#ifndef SECRETS_H
#define SECRETS_H

#define SECRET_WIFI_SSID   "your-wifi-ssid"
#define SECRET_WIFI_PASS   "your-wifi-password"
#define SECRET_API_KEY_511 "your-511-token"  // free at 511.org/open-data/token

// Which stop/route. Find stop ids at 511.org/open-data (beware paired stops:
// each direction has its own id).
#define SECRET_STOP_CODE  "12345"
#define SECRET_LINE_REF   "5"
#define SECRET_DEST_LABEL "Downtown"  // on-glass direction label
// Where the device fetches fresh schedule.json (see tools/gen_schedule.py);
// empty string = rely on the baked-in schedule.h only.
#define SECRET_SCHEDULE_URL ""

#endif
