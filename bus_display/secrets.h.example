// Copy to secrets.h (gitignored) and fill in real values.
#ifndef SECRETS_H
#define SECRETS_H

#define SECRET_WIFI_SSID   "your-wifi-ssid"
#define SECRET_WIFI_PASS   "your-wifi-password"
#define SECRET_API_KEY_511 "your-511-token"  // free at 511.org/open-data/token

// Two routes, one display row each. Find stop ids at 511.org/open-data
// (beware paired stops: each direction has its own id; terminal stops may
// serve BOTH directions of one line — set the DirectionRef filter there).
#define SECRET_STOP_CODE  "12345"
#define SECRET_LINE_REF   "5"
#define SECRET_DEST_LABEL "Downtown"  // on-glass label when no second bus
#define SECRET_DIR_REF    ""          // 511 DirectionRef ("IB"/"OB"); "" = any
#define SECRET_GTFS_DIR   ""          // GTFS direction_id ("0"/"1") for gen_schedule.py; "" = any

#define SECRET_STOP_CODE_2  "23456"
#define SECRET_LINE_REF_2   "67"
#define SECRET_DEST_LABEL_2 "Mission"
#define SECRET_DIR_REF_2    "IB"
#define SECRET_GTFS_DIR_2   "1"

// Where the device fetches fresh schedule.json (see tools/gen_schedule.py);
// empty string = rely on the baked-in schedule.h only.
#define SECRET_SCHEDULE_URL ""

#endif
